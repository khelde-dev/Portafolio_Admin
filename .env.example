# Copia este archivo a .env y completa los valores.
# La fuente de verdad es `env.schema` de astro.config.mjs.

# --- Servidor (nunca llegan al navegador) ---------------------------------
# Base de la API de contenido que edita el admin.
BACKEND_URL=

# Secreto: bearer que el backend espera. En produccion: `wrangler secret put`.
API_SECRET_TOKEN=

# SOLO desarrollo local: llave privada de prueba para hablar con el backend local.
# La genera `pnpm dev:access` (imprime tambien lo que va en el .env del backend).
DEV_ACCESS_KEY=

# Cloudflare Access (Zero Trust > Access > Applications > esta app).
# Vacios en local: el admin usa un usuario falso solo en `pnpm dev`.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# --- Cliente (se incrustan al compilar: variables de BUILD) ---------------
# Origen publico del bucket R2. Con dominio propio: https://media.khelde.dev
PUBLIC_MEDIA_URL=

# Servicio de iconos de tecnologias (el mismo que usa el portafolio). Es solo la
# base, sin "?i=": el admin agrega ?i=<nombre> y acepta varios separados por
# coma (?i=git,docker,c) para dibujar un conjunto en una sola imagen.
PUBLIC_ICONS_URL=

# ORIGEN del portafolio publico, sin ruta. Con dominio propio: https://khelde.dev
PUBLIC_PORTFOLIO_URL=
