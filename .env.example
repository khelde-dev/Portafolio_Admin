# Copia este archivo a .env y completa los valores.
# La fuente de verdad es `env.schema` de astro.config.mjs.

# --- Servidor (nunca llegan al navegador) ---------------------------------
# Base de la API de contenido que edita el admin.
BACKEND_URL=

# Secreto: bearer que el backend espera. En produccion: `wrangler secret put`.
API_SECRET_TOKEN=

# Cloudflare Access (Zero Trust > Access > Applications > esta app).
# Vacios en local: el admin usa un usuario falso solo en `pnpm dev`.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# --- Cliente (se incrustan al compilar: variables de BUILD) ---------------
# Origen publico del bucket R2. Con dominio propio: https://media.khelde.dev
PUBLIC_MEDIA_URL=

# URL del portafolio publico. Con dominio propio: https://khelde.dev
PUBLIC_PORTFOLIO_URL=
