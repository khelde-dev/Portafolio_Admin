{
	// Worker del panel de administracion (Astro SSR, adaptador @astrojs/cloudflare).
	// Build: `pnpm build`   Deploy: `npx wrangler deploy` (Workers Builds, rama main).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portafolio-admin",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": { "enabled": true },

	// Sin URLs de vista previa: este Worker se protege con Cloudflare Access y
	// cada URL extra seria una puerta mas sin proteger.
	"preview_urls": false,

	// Variables de runtime NO secretas (las lee astro:env/server). Se declaran
	// aqui para que un deploy no las borre. Las PUBLIC_* son de build: van en las
	// variables de build del panel de Cloudflare, no aqui.
	"vars": {
		"BACKEND_URL": "https://backend-portafolio.erickm-gonzalez-rivera.workers.dev/api",
		// De la aplicacion de Cloudflare Access que protege este Worker. No son
		// secretos (el AUD y el dominio del equipo aparecen en cada JWT). El
		// dominio lleva https:// y el MISMO valor va en el backend.
		"ACCESS_TEAM_DOMAIN": "https://throbbing-lake-8623.cloudflareaccess.com",
		"ACCESS_AUD": "a285709a3ab3c0bdfcfa01e6366d6a621602007ef0a8a51865745f2cd327b340"
	},

	// SECRETO (no va en este archivo): API_SECRET_TOKEN
	//   npx wrangler secret put API_SECRET_TOKEN
	// o en el panel: Worker > Settings > Variables and Secrets > Secret.
	//
	// Service Binding al Worker del backend: la llamada pasa de un Worker al otro
	// dentro de Cloudflare, sin salir a internet. Solo se usa en el Worker desplegado
	// (src/server/backendClient.ts); en `pnpm dev` y si el binding falta, se llama por
	// BACKEND_URL. El nombre del servicio es el `name` de wrangler.jsonc del backend.
	"services": [{ "binding": "BACKEND", "service": "backend-portafolio" }]
}
