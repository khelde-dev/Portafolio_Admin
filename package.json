{
  "name": "portafolio-admin",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "prettier": "prettier --write .",
    "prepare": "husky",
    "format": "pnpm exec biome format --write ./src",
    "lint": "pnpm exec biome lint --write ./src",
    "check:biome": "pnpm exec biome check --write ./src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hookform/resolvers": "^7.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "astro-compress": "^2.4.3",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "husky": "^9.1.7",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.3.1",
