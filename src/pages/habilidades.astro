---
import { SkillsList } from "@/components/content/ContentLists";
import PageHeader from "@/components/PageHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { cn } from "@/lib/utils";
import type { SkillRow } from "@/schemas/content";
import { loadList } from "@/server/data";

const { data, error } = await loadList<SkillRow[]>(
	Astro.request,
	"/skills/admin",
);
---

<AdminLayout title="Habilidades" activeId="habilidades" crumbs={[{ label: "Habilidades" }]}>
	<PageHeader
		title="Habilidades"
		description="Grupos de tecnologías. El orden de la lista es el del sitio."
		meta={data ? `${data.length} grupos` : undefined}
	>
		<a href="/habilidades/nuevo" class={cn(buttonVariants(), "min-h-11 px-4")}>Nuevo grupo</a>
	</PageHeader>
	<SkillsList client:load initial={data} initialError={error} />
</AdminLayout>
