---
import PageHeader from "@/components/PageHeader.astro";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { NAV } from "@/lib/nav";

const shortcuts = NAV.flatMap((group) => group.items).filter(
	(item) => !["panel", "estado", "cuenta"].includes(item.id),
);
---

<AdminLayout title="Panel" activeId="panel">
	<PageHeader title="Panel" description="Lo que llega y lo que puedes editar." />

	<ul class="grid gap-3 sm:grid-cols-2">
		{
			shortcuts.map((item) => (
				<li>
					<a
						href={item.href}
						class="hover-lift block rounded-lg border border-border bg-card px-5 py-4 font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</AdminLayout>
