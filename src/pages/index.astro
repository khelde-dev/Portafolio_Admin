---
import { LocalTime } from "@/components/LocalTime";
import PageHeader from "@/components/PageHeader.astro";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { NAV } from "@/lib/nav";
import { loadDashboard } from "@/server/data";

const { data, error } = await loadDashboard(Astro.request);

// Lo que espera atencion: un renglon por tema, con el numero grande en serif.
const attention = data
	? [
			{
				n: data.unread,
				href: "/mensajes",
				one: "mensaje sin leer",
				many: "mensajes sin leer",
			},
			{
				n: data.pending,
				href: "/comentarios",
				one: "comentario por moderar",
				many: "comentarios por moderar",
			},
			{
				n: data.drafts,
				href: "/proyectos",
				one: "proyecto en borrador",
				many: "proyectos en borrador",
			},
		]
	: [];
const allClear = attention.every((row) => row.n === 0);

const sections = NAV.filter(
	(group) => group.label && group.label !== "Sistema",
);
---

<AdminLayout title="Panel" activeId="panel">
	<PageHeader title="Panel" description="Lo que espera tu atención y desde dónde editar.">
	</PageHeader>

	<section aria-labelledby="atencion" class="mb-12">
		<h2 id="atencion" class="eyebrow mb-3">Para atender</h2>
		{
			error ? (
				<p role="alert" class="rounded-lg border border-destructive/40 bg-destructive/5 px-4 py-3 font-medium text-destructive">
					{error} <a class="underline underline-offset-4" href="/estado">Ver estado</a>
				</p>
			) : (
				<>
					<ul class="border-t border-border">
						{attention.map((row) => (
							<li class="border-b border-border">
								<a
									href={row.href}
									class="group flex min-h-20 items-baseline gap-5 px-1 py-4 transition-colors hover:bg-muted/50 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary"
								>
									<span
										class:list={[
											"w-14 text-right font-serif-display text-title tabular-nums",
											row.n === 0 && "text-muted-foreground",
										]}
									>
										{row.n}
									</span>
									<span class="text-[1.0625rem]">
										{row.n === 1 ? row.one : row.many}
										{row.n === 0 ? <span class="eyebrow ml-3">al día</span> : null}
									</span>
								</a>
							</li>
						))}
					</ul>
					{allClear ? <p class="mt-4 text-muted-foreground">No hay nada pendiente.</p> : null}
					{
						data?.lastEdit ? (
							<p class="eyebrow mt-4">
								Último cambio en proyectos: <LocalTime client:load value={data.lastEdit} />
							</p>
						) : null
					}
				</>
			)
		}
	</section>

	<div class="flex flex-col gap-10">
		{
			sections.map((group) => (
				<section aria-labelledby={`grupo-${group.label}`}>
					<h2 id={`grupo-${group.label}`} class="eyebrow mb-3">
						{group.label}
					</h2>
					<ul class="border-t border-border">
						{group.items.map((item) => (
							<li class="border-b border-border">
								<a
									href={item.href}
									class="flex min-h-14 items-center justify-between gap-4 px-1 font-serif-display text-heading transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary"
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</AdminLayout>
