---
import { AboutForm } from "@/components/content/AboutForm";
import PageHeader from "@/components/PageHeader.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import AdminLayout from "@/layouts/AdminLayout.astro";
import type { AboutRow } from "@/schemas/content";
import { loadList } from "@/server/data";

// Es una sola fila: puede no existir todavia (entonces el formulario arranca vacio).
const { data, error } = await loadList<AboutRow | null>(
	Astro.request,
	"/about/admin",
);
---

<AdminLayout title="Sobre mí" activeId="sobre-mi" crumbs={[{ label: "Sobre mí" }]}>
	<PageHeader
		title="Sobre mí"
		description="La sección de presentación del sitio. Es una sola: no se crea ni se borra, solo se edita."
	/>
	{
		error ? (
			<Alert variant="destructive">
<AlertDescription>{error} <a class="underline underline-offset-4" href="/estado">Ver estado</a></AlertDescription>
</Alert>
		) : (
			<AboutForm client:load initial={data} />
		)
	}
</AdminLayout>
