---
import { SkillForm } from "@/components/content/SkillForm";
import PageHeader from "@/components/PageHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { cn } from "@/lib/utils";
import { resourceId } from "@/schemas/common";
import type { SkillRow } from "@/schemas/content";
import { loadList } from "@/server/data";

// El backend no tiene "uno por id" para el CMS: se lee la lista y se busca.
const id = resourceId.safeParse(Astro.params.id);
const { data, error } = await loadList<SkillRow[]>(
	Astro.request,
	"/skills/admin",
);
const item = id.success ? data?.find((r) => r.skill_id === id.data) : undefined;

if (!error && !item) Astro.response.status = 404;
---

<AdminLayout
	title={item ? item.title_default : "Habilidades"}
	activeId="habilidades"
	crumbs={[{ label: item?.title_default ?? "No encontrado" }]}
>
	{
		item ? (
			<>
				<PageHeader title={item.title_default} />
				<SkillForm client:load initial={item} />
			</>
		) : (
			<>
				<PageHeader title={error ? "No se pudo cargar" : "No encontrado"} />
				<p class="max-w-[62ch] text-muted-foreground">
					{error ?? "Ese elemento ya no existe o la dirección no es correcta."}
				</p>
				<a href="/habilidades" class={cn(buttonVariants({ variant: "outline" }), "mt-6 min-h-11 px-4")}>
					Volver a Habilidades
				</a>
			</>
		)
	}
</AdminLayout>
