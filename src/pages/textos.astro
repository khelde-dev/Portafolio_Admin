---
import PageHeader from "@/components/PageHeader.astro";
import { SiteCopyForm } from "@/components/site/SiteCopyForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import AdminLayout from "@/layouts/AdminLayout.astro";
import type { SiteCopyRow } from "@/schemas/siteCopy";
import { loadList } from "@/server/data";

// Es una sola ficha: puede no existir todavia (entonces el formulario arranca vacio).
const { data, error } = await loadList<SiteCopyRow | null>(
	Astro.request,
	"/site-copy/admin",
);
---

<AdminLayout title="Textos del sitio" activeId="textos" crumbs={[{ label: "Textos del sitio" }]}>
	<PageHeader
		title="Textos del sitio"
		description="La foto y los textos de la portada, la frase del manifiesto y la descripción para buscadores, en tres idiomas. Es una sola ficha: se edita, no se crea ni se borra."
	/>
	{
		error ? (
			<Alert variant="destructive">
				<AlertDescription>
					{error} <a class="underline underline-offset-4" href="/estado">Ver estado</a>
				</AlertDescription>
			</Alert>
		) : (
			<SiteCopyForm client:load initial={data} />
		)
	}
</AdminLayout>
