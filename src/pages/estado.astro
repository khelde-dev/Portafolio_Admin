---
import { ACCESS_AUD, ACCESS_TEAM_DOMAIN, ADMIN_EMAILS } from "astro:env/server";
import PageHeader from "@/components/PageHeader.astro";
import { Badge } from "@/components/ui/badge";
import {
	Table,
	TableBody,
	TableCell,
	TableHead,
	TableHeader,
	TableRow,
} from "@/components/ui/table";
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
	backendChannel,
	getBackendHealth,
	MIN_BACKEND_VERSION,
	meetsVersion,
	probeBackendAuth,
} from "@/server/status";
import pkg from "../../package.json";

const [health, auth] = await Promise.all([
	getBackendHealth(),
	probeBackendAuth(Astro.request),
]);
const versionOk = meetsVersion(health.version);
const channel = await backendChannel();

// Solo si estan puestos: nunca se muestran los valores.
const checks = [
	{
		label: "Cloudflare Access configurado",
		ok: Boolean(ACCESS_AUD && ACCESS_TEAM_DOMAIN),
		hint: "Faltan ACCESS_AUD o ACCESS_TEAM_DOMAIN en wrangler.jsonc.",
	},
	{
		label: "Lista de correos permitidos (ADMIN_EMAILS)",
		ok: Boolean(ADMIN_EMAILS),
		hint: "Sin la lista solo manda la política de Access. Cárgala como secreto.",
	},
	{
		label: "El backend responde",
		ok: health.ok,
		hint: health.status
			? `Respondió con el estado ${health.status}.`
			: "No hubo respuesta. Revisa BACKEND_URL y que el Worker esté desplegado.",
	},
	{
		label: "El backend acepta al admin (token y Access)",
		ok: auth.ok,
		hint: auth.hint,
	},
	{
		label: `Versión del backend (mínima ${MIN_BACKEND_VERSION})`,
		ok: versionOk,
		hint: health.version
			? `Tiene la ${health.version}: actualiza el backend antes de usar esta pantalla.`
			: "No se pudo leer la versión.",
	},
];
---

<AdminLayout title="Estado" activeId="estado" crumbs={[{ label: "Estado" }]}>
	<PageHeader
		title="Estado"
		description="Primer lugar donde mirar cuando algo no carga."
	/>

	<dl class="mb-8 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-4">
		<div class="bg-card px-5 py-4">
			<dt class="text-muted-foreground">Admin</dt>
			<dd class="mt-1 font-serif-display text-heading">{pkg.version}</dd>
		</div>
		<div class="bg-card px-5 py-4">
			<dt class="text-muted-foreground">Backend</dt>
			<dd class="mt-1 font-serif-display text-heading">{health.version ?? "—"}</dd>
		</div>
		<div class="bg-card px-5 py-4">
			<dt class="text-muted-foreground">Tiempo de respuesta</dt>
			<dd class="mt-1 font-serif-display text-heading">{health.ms} ms</dd>
		</div>
		<div class="bg-card px-5 py-4">
			<dt class="text-muted-foreground">Conexión</dt>
			<dd class="mt-1 font-serif-display text-heading">
				{channel === "binding" ? "Service Binding" : "URL pública"}
			</dd>
		</div>
	</dl>

	<Table aria-label="Comprobaciones">
		<TableHeader>
			<TableRow>
				<TableHead>Comprobación</TableHead>
				<TableHead className="w-32">Resultado</TableHead>
			</TableRow>
		</TableHeader>
		<TableBody>
			{
				checks.map((check) => (
					<TableRow>
						<TableCell className="whitespace-normal">
							<p>{check.label}</p>
							{!check.ok ? (
								<p class="mt-1 text-sm text-muted-foreground">{check.hint}</p>
							) : null}
						</TableCell>
						<TableCell className="align-top">
							{check.ok ? (
								<Badge variant="secondary">Correcto</Badge>
							) : (
								<Badge variant="destructive">Revisar</Badge>
							)}
						</TableCell>
					</TableRow>
				))
			}
		</TableBody>
	</Table>
</AdminLayout>
