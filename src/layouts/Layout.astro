---
import "@/styles/app.css";
import { THEME_SCRIPT } from "@/lib/inlineScripts";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="color-scheme" content="light dark" />
		<title>{title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- Tema antes del primer pintado (sin parpadeo). El texto sale de
		     src/lib/inlineScripts.ts, de donde astro.config.mjs calcula su hash. -->
		<script is:inline set:html={THEME_SCRIPT}></script>
	</head>
	<body>
		<slot />
	</body>
</html>
