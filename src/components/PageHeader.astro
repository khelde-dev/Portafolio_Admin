---
interface Props {
	title: string;
	description?: string;
	/** Dato corto en mono bajo el titulo ("21 proyectos", "3 sin leer"). */
	meta?: string;
}

const { title, description, meta } = Astro.props;
---

<header class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-4 border-b border-border pb-6">
	<div class="min-w-0">
		<h1 class="font-serif-display text-subtitle">{title}</h1>
		{description ? <p class="mt-2 max-w-[62ch] text-muted-foreground">{description}</p> : null}
		{meta ? <p class="eyebrow mt-3">{meta}</p> : null}
	</div>
	<div class="flex flex-wrap items-center gap-2">
		<slot />
	</div>
</header>
